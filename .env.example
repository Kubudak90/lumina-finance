# WalletConnect Cloud project id — required for the wallet modal in production.
# Get one at https://cloud.walletconnect.com (free).
NEXT_PUBLIC_WC_PROJECT_ID=

# Shared secret used to authenticate Vercel Cron requests to /api/cron/update-prices.
# Vercel Cron sends "Authorization: Bearer ${CRON_SECRET}" automatically when this is set
# in the Vercel project env. Generate any high-entropy random string.
CRON_SECRET=

# Private key for the on-chain keeper that pushes CoinGecko prices into the
# UpdatableAggregator + MockSwapper on Base Sepolia. Used by /api/cron/update-prices.
# Must hold a small amount of Base Sepolia ETH for gas. NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=

# Optional CoinGecko Pro API key. If unset the public free endpoint is used (rate-limited).
COINGECKO_API_KEY=
