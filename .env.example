# RPC of Lighter EVM devnet (chain 19529). Inlined at build time; its origin is the only RPC origin in the CSP.
# Client-side twin of the manifest's rpcEnv (LIGHTER_DEVNET_RPC_URL).
NEXT_PUBLIC_LIGHTER_DEVNET_RPC_URL=

# WalletConnect Cloud project id — required for the wallet modal in production.
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Lighter trading signer WASM. The CSP only allows same-origin, so vendor it under /public.
# NEXT_PUBLIC_LIGHTER_WASM_URL=

# Local harness builds only ("harness" accepts Anvil-signed manifests; omit in production).
# NEXT_PUBLIC_LUMINA_SIGNER_SET=
